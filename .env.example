# ── Core ──────────────────────────────────────────────────────────────
PORT=3000
# Externally reachable URL. OAuth redirect URI = $PUBLIC_URL/oauth/callback — register that with every provider.
PUBLIC_URL=http://localhost:3000
# postgres://user:pass@host:5432/db in production; pglite:./data/pglite for local dev
DATABASE_URL=pglite:./data/pglite
# Encryption keys for stored credentials: <keyId>:<base64 32 bytes>[,<oldKeyId>:<key>…]. First one encrypts.
# Generate: echo "k1:$(openssl rand -base64 32)"
MASTER_KEYS=
# Platform-operator token for /admin (tenant provisioning). Generate: openssl rand -hex 32
ADMIN_TOKEN=
# Origins that connect links may redirect back to after a user connects (comma-separated). localhost is always allowed.
ALLOWED_REDIRECT_ORIGINS=
CONNECT_LINK_TTL_MINUTES=30
TOOL_TIMEOUT_MS=60000
REFRESH_SWEEP_SECONDS=600
LOG_LEVEL=info

# ── Master keys held by Vault Transit (instead of MASTER_KEYS) ──
# MASTER_KEYS_WRAPPED=k1:vault:v1:...     # vault write -field=ciphertext transit/encrypt/connect-hub plaintext=$(openssl rand -base64 32)
# VAULT_ADDR=http://vault.vault.svc.cluster.local:8200
# VAULT_K8S_ROLE=connect-hub              # or VAULT_TOKEN=...
# VAULT_TRANSIT_KEY=connect-hub

# ── Single sign-on for MCP OAuth (people authorize MCP clients such as Paperclip) ──
# OIDC_ISSUER=https://keycloak.example.com/realms/bionic
# OIDC_CLIENT_ID=connect-hub
# OIDC_CLIENT_SECRET=
# MCP_OAUTH_ACCESS_TTL_SECONDS=3600
# MCP_OAUTH_REFRESH_TTL_DAYS=30

# ── Triggers ──
TRIGGER_TICK_SECONDS=10
# TRIGGER_ALLOW_PRIVATE_WEBHOOKS=false   # true only for tests / trusted single-tenant setups

# ── Platform-managed OAuth apps (optional; tenants can bring their own via /v1/auth-configs) ──
# One app per provider family serves every toolkit of that family.
# OAUTH_GOOGLE_CLIENT_ID=        # Gmail, Drive, Sheets, Docs, Slides, Forms, Calendar, Contacts, Tasks, YouTube, Search Console, My Business, Analytics
# OAUTH_GOOGLE_CLIENT_SECRET=
# OAUTH_GITHUB_CLIENT_ID=
# OAUTH_GITHUB_CLIENT_SECRET=
# OAUTH_SLACK_CLIENT_ID=
# OAUTH_SLACK_CLIENT_SECRET=
# OAUTH_FACEBOOK_CLIENT_ID=      # Facebook Pages + Instagram Business
# OAUTH_FACEBOOK_CLIENT_SECRET=
# OAUTH_LINKEDIN_CLIENT_ID=
# OAUTH_LINKEDIN_CLIENT_SECRET=
# OAUTH_REDDIT_CLIENT_ID=
# OAUTH_REDDIT_CLIENT_SECRET=
# OAUTH_TODOIST_CLIENT_ID=
# OAUTH_TODOIST_CLIENT_SECRET=
# OAUTH_ZOOM_CLIENT_ID=
# OAUTH_ZOOM_CLIENT_SECRET=
# OAUTH_ATLASSIAN_CLIENT_ID=       # Atlassian (Jira + Confluence) OAuth 2.0 (3LO)
# OAUTH_ATLASSIAN_CLIENT_SECRET=
