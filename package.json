{
  "name": "connect-hub",
  "version": "0.1.0",
  "private": true,
  "description": "Multi-tenant integration hub: managed auth, connected accounts, tool execution and MCP gateway for 3rd-party apps.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc -p tsconfig.build.json && cp -r src/db/migrations dist/db/ && cp -r src/dashboard dist/",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "catalog:list": "tsx scripts/catalog-list.ts",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "catalog:add": "node scripts/add-pieces.mjs"
  },
  "dependencies": {
    "@activepieces/piece-apify": "^0.4.1",
    "@activepieces/piece-confluence": "^0.4.1",
    "@activepieces/piece-facebook-pages": "^0.4.2",
    "@activepieces/piece-github": "^0.11.0",
    "@activepieces/piece-gmail": "^0.18.3",
    "@activepieces/piece-google-calendar": "^0.13.3",
    "@activepieces/piece-google-contacts": "^0.6.0",
    "@activepieces/piece-google-docs": "^0.6.3",
    "@activepieces/piece-google-drive": "^0.13.1",
    "@activepieces/piece-google-forms": "^0.7.4",
    "@activepieces/piece-google-my-business": "^0.6.0",
    "@activepieces/piece-google-search-console": "^0.4.1",
    "@activepieces/piece-google-sheets": "^0.19.3",
    "@activepieces/piece-google-slides": "^0.4.2",
    "@activepieces/piece-google-tasks": "^0.7.2",
    "@activepieces/piece-instagram-business": "^1.1.1",
    "@activepieces/piece-jira-cloud": "^0.6.2",
    "@activepieces/piece-linkedin": "^0.6.1",
    "@activepieces/piece-reddit": "^0.4.0",
    "@activepieces/piece-slack": "^0.23.1",
    "@activepieces/piece-todoist": "^0.6.2",
    "@activepieces/piece-youtube": "^0.9.3",
    "@activepieces/piece-zoom": "^0.9.2",
    "@electric-sql/pglite": "^0.5.14",
    "@fastify/formbody": "^9.0.1",
    "@fastify/rate-limit": "^11.2.1",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "fastify": "^5.12.7",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
